{
  "name": "opennote",
  "version": "1.0.0",
  "description": "OpenNote PWA rewritten in TypeScript",
  "main": "dist/index.js",
  "author": "Jacob Liscom",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bootstrap": "^5.3.0",
    "codemirror": "^6.0.1",
    "jquery": "^3.7.0",
    "marked": "^9.0.0",
    "pouchdb": "^7.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.4.0",
    "eslint": "^8.48.0",
    "eslint-plugin-import": "^2.30.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
