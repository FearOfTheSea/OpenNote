{
    "tasks": {
        "dev": "deno run --watch --allow-net --allow-env --allow-read --env-file openNote/Main.ts",
        "rollback-all": "deno run -A https://deno.land/x/nessie/cli.ts rollback all --config ./openNote/infrastructure/db/nessie.config.ts",
        "migrate": "deno run -A https://deno.land/x/nessie/cli.ts migrate --config ./openNote/infrastructure/db/nessie.config.ts",
        "reset-db": "deno task rollback-all && deno task migrate"
    },
    "imports": {
        "@std/assert": "https://deno.land/std@0.201.0/assert/mod.ts",
        "@std/path": "https://deno.land/std@0.214.0/path/mod.ts",
        "dotenv": "https://deno.land/std@0.224.0/dotenv/mod.ts",
        "pg": "https://deno.land/x/postgres@v0.19.3/mod.ts",
        "express": "npm:express@^5.1.0",
        "nessie": "https://deno.land/x/nessie@2.0.11/mod.ts"
    },
    "fmt": {
        "indentWidth": 4,
        "lineWidth": 120
    }
}
