{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read --allow-ffi --env-file openNote/Main.ts",
    "run-worker": "deno run --watch --allow-net --allow-env --allow-read --allow-ffi --env-file openNote/interface/worker/Worker.ts",
    "rollback-all": "deno run -A --import-map=import_map.json https://deno.land/x/nessie@2.0.11/cli.ts rollback all --config ./openNote/infrastructure/db/nessie.config.ts",
    "migrate": "deno run -A --import-map=import_map.json https://deno.land/x/nessie@2.0.11/cli.ts migrate --config ./openNote/infrastructure/db/nessie.config.ts",
    "reset-db": "deno task rollback-all && deno task migrate"
  },
  "importMap": "import_map.json",
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 120
  },
  "nodeModulesDir": "auto"
}
